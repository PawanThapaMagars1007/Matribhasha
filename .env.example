# Copy to server/.env. Replace the JWT placeholder with a unique random value (32+ characters).
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/matribhasha
MONGODB_MAX_POOL_SIZE=20
TRUST_PROXY_HOPS=0
JWT_SECRET=generate-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Optional, backend only. If used, the provider URL must use HTTPS in production.
TUTOR_API_KEY=
TUTOR_API_BASE_URL=https://api.openai.com/v1
TUTOR_MODEL=gpt-4o-mini
# Not wired to storage yet. Leave all three blank until a private-media adapter is implemented.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
